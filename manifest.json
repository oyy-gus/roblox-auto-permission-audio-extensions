{
  "manifest_version": 3,
  "name": "Roblox Auto Permission - Pro Tool",
  "version": "10.1.0",
  "description": "Otomatisasi izin Audio Collaborators & Experiences di Roblox Creator Dashboard!",
  "homepage_url": "https://github.com/oyy-gus/roblox-auto-permission-audio-extensions",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://create.roblox.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://create.roblox.com/dashboard/creations*",
        "https://create.roblox.com/dashboard/creations/store/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
